{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetPulse",
  "version": "3.0.4",
  "identifier": "local.netpulse.desktop.v2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NetPulse 3.0.4",
        "width": 1240,
        "height": 850,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Local Windows VPN client",
    "category": "Utility",
    "resources": {
      "../../../release-v2/licenses/": "licenses/",
      "../../../release-v2/LICENSE.txt": "LICENSE.txt",
      "../LICENSE-NOTICE.md": "LICENSE-NOTICE.md",
      "../README.md": "README.md",
      "../resources/NetPulseService.exe": "NetPulseService.exe",
      "../../../docs/netpulse-v2-windows-check.md": "netpulse-v2-windows-check.md",
      "../resources/cores/": "cores/"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "Russian",
          "English"
        ],
        "installerHooks": "windows/hooks.nsh",
        "template": "windows/installer.nsi"
      },
      "allowDowngrades": false
    },
    "homepage": "https://github.com/HACKYASHER/NetPulse"
  }
}
